10 "A" CLEAR: RANDOM: W=&C53B, X=&C53A, Y=&C500, A=5, B=6: WAIT 200: PRINT "*EARTH DEFENDER*": GOSUB "B": GOTO 100
20 "B" WAIT 0: PRINT "            ";STR$ D;"%": POKE X,6: POKE W,1: CALL Y
30 POKE X,5+2V: POKE W,2+V+2U: CALL Y: POKE W,6: IF M>0 POKE X,M: CALL Y
40 IF N>0 POKE X,N : CALL Y
50 CALL 4576: RETURN

100 L= ASC INKEY$: IF L=52 AND V=1 POKE X,7: POKE W,0: CALL Y: V=0
110 IF L=54 AND V=0 POKE X,5: POKE W,0: CALL Y: V=1
120 IF L=56 LET U=1-U
130 IF L=50 AND U=0 LET Z=4+4V: GOTO 200
140 POKE X,5+2V: POKE W,2+V+2U: CALL Y
150 O=1-O: IF O=0 LET P=M: GOSUB "C": M=P: GOTO 100
160 P=N: GOSUB "C": N=P: GOTO 100

200 POKE X,Z: POKE W,9: CALL Y: IF Z=M OR Z=N GOTO 250
210 POKE W,0: CALL Y: Z=Z-1+2V: IF Z=2 OR Z=10 GOTO 150
220 GOTO 200

250 POKE X,Z: POKE W,10: CALL Y: FOR L=0 TO 9: NEXT L: POKE W,0: CALL Y
260 S=S+1: IF S/A = INT(S/A) LET A=A+5: B=B-1: IF B=0 LET B=1
270 IF V=0 LET M=0: GOTO 100
280 N=0: GOTO 100

300 "C" IF R>0 GOTO 400
310 IF P=0 GOTO 350
320 IF RND(B/2+1) = 1 POKE X,P: POKE W,0: CALL Y: P=P+1-2O: IF P=5+2O GOSUB "D": P=0: RETURN
330 POKE X,P :POKE W,6 : CALL Y: RETURN

350 IF RND B <> 1 RETURN
360 P=1+10O: IF RND(B/2+1) = 1 LET Q=O: R=P
370 GOTO 330

400 R=R+1-2Q: POKE X,R: POKE W, 9: CALL Y: IF R=6 GOTO "D"
410 IF R=5+2Q AND Q=V AND U=1 LET R=0: GOSUB "B"
420 RETURN

500 "D" D=D+25:IF D=100 GOTO 540 
510 IF O=0 LET M=0: GOTO 530
520 N=0
530 GOSUB "B": R=0: RETURN
540 POKE W, 10: FOR L=0 TO 2: POKE X,5+L: CALL Y: NEXT L: FOR L=0 TO 29: NEXT L
550 WAIT 200: PRINT " * GAME  OVER * ": PRINT "SCORE:"; S: END
