10 "A" CLEAR: RANDOM: W=&C53B, X=&C53A, Y=&C500: WAIT 200: PRINT "*EARTH DEFENDER*": GOSUB 20: GOTO 30
20 WAIT 0: PRINT "            ";STR$ D;"%": POKE X,6: POKE W,1: CALL Y: CALL &11E0: RETURN

30 L= ASC INKEY$: IF L=52 AND V=1 POKE X,7: POKE W,0: CALL Y: V=0
40 IF L=54 AND V=0 POKE X,5: POKE W,0: CALL Y: V=1
50 IF L=56 LET U=1-U
60 IF L=50 AND U=0 LET Z=4+4V: GOTO 200
70 POKE X,5+2V: POKE W,2+V+U*2: CALL Y

80 O=0: P=M: GOSUB 300: M=P: O=1: P=N: GOSUB 300: N=P: GOTO 30

200 POKE X,Z: POKE W,9: CALL Y: IF Z=M OR Z=N GOTO 250
210 POKE W,0: CALL Y: Z=Z-1+2V: IF Z=0 OR Z=12 GOTO 80
220 GOTO 200

250 POKE X,Z: POKE W,10: CALL Y:FOR L=0 TO 9: NEXT L: POKE W,0: CALL Y
260 S=S+1: IF V=0 LET M=0: GOSUB 20: GOTO 30
270 N=0: GOSUB 20: GOTO 30

300 IF R>0 GOTO 400
305 IF P=0 GOTO 330
310 IF RND 3 = 1 POKE X,P: POKE W,0: CALL Y: P=P+1-2O:IF P=5+2O GOSUB 500: P=0: RETURN
320 POKE X,P :POKE W,6 : CALL Y: RETURN

330 IF RND 6 <> 1 RETURN
340 P=1+10O: IF RND 3 = 1 LET Q=O: R=P
350 GOTO 320

400 R=R+1-2Q:POKE X,R : POKE W, 9: CALL Y: IF R=6 GOTO 500
410 IF R=5+2Q AND Q=O AND U=1 LET R=0: GOSUB 20
420 RETURN

500 D=D+25:IF D<100 GOSUB 20: R=0: RETURN
510 POKE W, 10: FOR L=0 TO 2:POKE X,5+L :CALL Y: NEXT L:FOR L=0 TO 29:NEXT L
520 WAIT 200: PRINT " * GAME  OVER * ": PRINT "SCORE:"; S: END
